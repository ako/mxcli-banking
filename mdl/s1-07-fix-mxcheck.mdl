-- =====================================================================
-- RRNetBanking — Slice 1: corrections found by 'mx check'
--
-- 'mxcli check' passed on every script in this slice, but Mendix's own
-- 'mx check' found seven consistency errors. This script applies the
-- fixes; the source scripts have been updated to match, so a rebuild from
-- scratch would not need it.
--
-- CE0069  Banking.Customer.FullName duplicated Administration.Account.FullName
-- CE7247  a user entity may not carry Required/Unique validation rules,
--         which the NOT NULL on that same FullName was
-- CE0106  microflows used as page datasources need an allowed role
-- CE0156  every user role needs at least one System module role
-- =====================================================================

-- CE0069 + CE7247: use the inherited Administration.Account.FullName.
ALTER ENTITY Banking.Customer DROP ATTRIBUTE IF EXISTS FullName;
/

-- CE0156: without a System module role the user role cannot sign in.
ALTER USER ROLE Customer ADD MODULE ROLES (System.User);
/

-- CE0106: the dashboard calls both of these as datasources.
GRANT EXECUTE ON MICROFLOW Banking.DS_CurrentCustomer TO Banking.AccountHolder;
/
GRANT EXECUTE ON MICROFLOW Banking.DS_MyAccounts TO Banking.AccountHolder;
/
